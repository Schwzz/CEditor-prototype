{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framecode",
  "version": "0.3.0",
  "identifier": "dev.schwzz.framecode",
  "build": {
    "frontendDist": "../build/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Framecode",
        "width": 1440,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 740,
        "backgroundColor": "#141617",
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
