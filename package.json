{
  "name": "ceditor-prototype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Framecode Windows desktop code-and-timeline editor prototype",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "check": "node scripts/check.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "productName": "Framecode",
  "main": "desktop/main.cjs",
  "author": "Schwzz"
}
